NEXT_PUBLIC_APP_URL=http://localhost:3000
LAND_BANKER_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only 32+ byte capability for the distributed share gateway.
# Never prefix this with NEXT_PUBLIC or commit a real value.
LANDOS_SHARE_GATEWAY_SECRET=
# Importer only; never supply MaxQI credentials to the web app
LAND_BANKER_PROJECT_REF=
LAND_BANKER_IMPORT_SECRET_KEY=
LAND_BANKER_IMPORT_WORKSPACE_ID=
MAXQI_READONLY_URL=
MAXQI_READONLY_KEY=

# Terrain stays disabled until a reviewed HTTPS TileJSON and attribution are supplied.
NEXT_PUBLIC_TERRAIN_TILEJSON_URL=
NEXT_PUBLIC_TERRAIN_ATTRIBUTION=
# Supported Terrarium tile sizes are 256 and 512; default is 512.
NEXT_PUBLIC_TERRAIN_TILE_SIZE=512
NEXT_PUBLIC_TERRAIN_RESOLUTION=
NEXT_PUBLIC_TERRAIN_DATUM=
NEXT_PUBLIC_TERRAIN_ACCURACY=

# Alternative to TILEJSON_URL: exactly one HTTPS XYZ Terrarium template.
NEXT_PUBLIC_TERRAIN_XYZ_URL=
NEXT_PUBLIC_TERRAIN_MAXZOOM=12
# Set only after confirming consistent vertical datum across the selected source.
NEXT_PUBLIC_TERRAIN_DATUM_VERIFIED=0
# The built-in Tilezen candidate is development-only and unavailable in production builds.
NEXT_PUBLIC_TERRAIN_TEST_TILEZEN=0
NEXT_PUBLIC_TERRAIN_PROVIDER=configured

# ArcGIS key is sent to browsers when explicitly enabled: restrict it to the
# production origin and World Imagery, and configure quotas before enabling.
ARCGIS_API_KEY=
ESRI_IMAGERY_ENABLED=false
# Google Map Tiles is not enabled until session and attribution integration is verified.
GOOGLE_MAPS_API_KEY=
